name: Build AURELIS APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: write
  issues: write

concurrency:
  group: build
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'

      - name: Build the APK
        run: |
          set -o pipefail
          gradle assembleDebug --no-daemon 2>&1 | tee build.log

      - name: Report build errors
        if: failure()
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          { echo '```'; grep -E "^e: |error:|What went wrong|Could not|Unresolved" build.log | head -150; echo '```'; echo; echo '```'; tail -60 build.log; echo '```'; } > report.md
          gh issue create --title "Build ${{ github.run_number }} failed" --body-file report.md

      - name: Rename APK
        run: cp app/build/outputs/apk/debug/app-debug.apk AURELIS.apk

      - uses: actions/upload-artifact@v4
        with:
          name: AURELIS-APK
          path: AURELIS.apk

      - uses: softprops/action-gh-release@v2
        with:
          tag_name: build-${{ github.run_number }}
          name: AURELIS build ${{ github.run_number }}
          files: AURELIS.apk
